{
  "id": "express-api",
  "version": "0.1.0",
  "kind": "template",
  "description": "A hardened Express 5 + TypeScript API with validated config, health check, tests, and an optional locked-down Docker image.",
  "questions": [
    { "id": "description", "type": "string", "message": "One-line project description", "default": "An Express API" },
    {
      "id": "port",
      "type": "string",
      "message": "Port the service listens on (10-65535)",
      "default": "3000",
      "pattern": "^(?:[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    },
    { "id": "docker", "type": "boolean", "message": "Include a hardened Dockerfile?", "default": true },
    { "id": "license", "type": "enum", "message": "License", "choices": ["MIT", "none"], "default": "MIT" }
  ],
  "files": [
    { "path": "Dockerfile.hbs", "when": { "answer": "docker", "equals": true } },
    { "path": "_dot_dockerignore", "when": { "answer": "docker", "equals": true } },
    { "path": "LICENSE.hbs", "when": { "answer": "license", "equals": "none", "not": true } }
  ]
}
